# Variables lues automatiquement par docker compose (interpolation ${VAR} dans docker-compose.yml).
# Modifier une valeur ici puis relancer : docker compose up -d --build
# Aucun secret ici : le fichier est versionné volontairement.

# --- Commun ---
ALPINE_VERSION=3.20
TZ=Europe/Paris

# --- Back (API) ---
BACK_PORT=3000
BACK_NODE_MAX_MEMORY=128
BACK_PHRASE=Hello World depuis le back !
BACK_CPUS=0.50
BACK_MEMORY=192M
BACK_MEMORY_RESERVATION=64M

# --- Gateway (nginx) ---
GATEWAY_PORT=80
GATEWAY_WORKER_PROCESSES=1
GATEWAY_WORKER_CONNECTIONS=512
GATEWAY_CPUS=0.50
GATEWAY_MEMORY=64M
GATEWAY_MEMORY_RESERVATION=16M

# --- Front (point d'entrée) ---
FRONT_PORT=80
FRONT_PUBLISHED_PORT=8080
FRONT_NODE_MAX_MEMORY=128
FRONT_CPUS=0.50
FRONT_MEMORY=192M
FRONT_MEMORY_RESERVATION=64M
