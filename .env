# Un seul fichier pour toute la configuration : on règle la stack sans toucher au compose ni aux Dockerfile.
# Versionné volontairement : il ne contient aucun secret.
# Ressources fixées d'après les mesures de Bench/run-bench.ps1 sur l'application réelle (détail dans le
# README, section Benchmark) : CPU dosé selon le coût par requête de chaque service, 1 CPU au total.

# --- Commun ---
# Version fixée plutôt que latest : build reproductible.
# 3.22 et non 3.20 : Angular 22 exige Node >= 22.22 (3.20 ne fournit que Node 20.15), et Alpine 3.20
# comme Node 20 sont en fin de support (avril 2026). 3.22 : Node 22 LTS, OS maintenu jusqu'en 2027
ALPINE_VERSION=3.22
TZ=Europe/Paris
# 50 Mo : suffisant pour des documents et images courants, sans laisser saturer le stockage d'un seul envoi
# Partagé par la gateway (refus avant le back) et le back (double sécurité)
MAX_UPLOAD_MB=50

# --- Back (API) ---
BACK_PORT=3000
# Sous /data obligatoirement : c'est là qu'est monté le volume "stockage", ailleurs les fichiers seraient perdus
STORAGE_DIR=/data/files
# GID du groupe partagé back / cleaner : une seule valeur ici, donc identique dans les deux images
STORAGE_GID=1500

# --- Fichiers éphémères ---
# 24 h par défaut : le cas d'usage type (partager un fichier pour la journée)
TTL_DEFAULT_H=24
# 7 jours max : au-delà, ce n'est plus du stockage temporaire et le volume se remplirait
TTL_MAX_H=168
# 1 Go au total : protège le disque de l'hôte, même si des envois s'accumulent avant leur expiration
STORAGE_QUOTA_MB=1024
# Service le plus coûteux de l'application réelle : ~2,8 ms de CPU par requête de liste (lecture du dossier
# + un stat par fichier), 7x la gateway. 0,65 CPU (sur 1 CPU au total) tient ~230 req/s, au niveau des autres
BACK_CPUS=0.65
# Pic mesuré ~33 Mo (5 envois de 20 Mo en parallèle, écriture en flux) : 128 Mo laissent ~4x de marge
BACK_MEMORY=128M
# Tas Node à la moitié de la limite : le reste couvre la mémoire hors tas (buffers des flux d'upload)
BACK_NODE_MAX_MEMORY=64
# Réservation au-dessus du pic mesuré : le service garde de quoi tourner si l'hôte manque de mémoire
BACK_MEMORY_RESERVATION=32M

# --- Cleaner (worker de nettoyage) ---
# 60 s : la libération d'espace disque n'a pas besoin d'être plus rapide, l'API masque déjà les expirés
CLEANUP_INTERVAL_S=60
# 60 min : même un envoi de 50 Mo à 100 Ko/s dure moins de 9 min, un .part plus vieux est abandonné
INCOMING_MAX_AGE_MIN=60
# Mesuré sur 10 000 fichiers expirés : passe en 6 s à 0,10 CPU (13 s à 0,05, 2 s à 0,25).
# 0,10 : la passe reste bien plus courte que l'intervalle, et le worker n'a besoin de rien au repos (0 %)
CLEANER_CPUS=0.10
# Pic mesuré ~4 Mo à 0,10 CPU (~8 Mo à 0,05, le listage de 10 000 noms) ; ~0,5 Mo au repos
CLEANER_MEMORY=16M
# Minimum accepté par Docker pour une réservation
CLEANER_MEMORY_RESERVATION=6M

# --- Gateway (nginx) ---
GATEWAY_PORT=80
# 1 worker : un seul CPU alloué (moins d'un), plus de workers que de CPU n'apporterait rien
GATEWAY_WORKER_PROCESSES=1
GATEWAY_WORKER_CONNECTIONS=512
# Le moins coûteux : ~0,4 ms de CPU par requête mesuré (7x moins que le back). 0,10 CPU tient ~250 req/s
GATEWAY_CPUS=0.10
# ~4 Mo en charge normale, mais pic à ~26 Mo pendant 5 envois de 20 Mo en parallèle ; le tmpfs (8 Mo)
# compte aussi dans cette limite : 26 + 8 dépasserait 32 Mo, d'où 48 Mo (encore 2,7x moins que Node)
GATEWAY_MEMORY=48M
GATEWAY_MEMORY_RESERVATION=8M
# /tmp en RAM (lecture seule ailleurs) : quelques Ko suffisent (config, PID), nginx ne bufferise
# ni les envois ni les téléchargements sur disque. Compté dans la limite mémoire du conteneur
GATEWAY_TMPFS_SIZE=8m

# --- Front (point d'entrée) ---
FRONT_PORT=80
# 8080 côté hôte : évite le port 80, souvent déjà pris ou réservé sur la machine
FRONT_PUBLISHED_PORT=8080
# ~1,2 ms de CPU par requête mesuré (il relaie tout, 3x la gateway) : 0,25 CPU tient ~210 req/s
FRONT_CPUS=0.25
# Pic mesuré ~37 Mo (5 envois en parallèle relayés en flux) : même logique que le back (128 Mo, tas à 64 Mo)
FRONT_MEMORY=128M
FRONT_NODE_MAX_MEMORY=64
FRONT_MEMORY_RESERVATION=32M

# --- Bench (profil "bench", outil de mesure) ---
# 1 CPU : plus que les 3 services réunis, pour que l'outil de mesure ne soit jamais le goulot
BENCH_CPUS=1.0
# ab ne garde presque rien en mémoire (~2 Mo mesurés)
BENCH_MEMORY=32M
