# Un seul fichier pour toute la configuration : on règle la stack sans toucher au compose ni aux Dockerfile.
# Versionné volontairement : il ne contient aucun secret.
# Ressources fixées d'après les mesures de Bench/run-bench.ps1 (détail dans le README, section Benchmark).

# --- Commun ---
# Version fixée plutôt que latest : build reproductible
ALPINE_VERSION=3.20
TZ=Europe/Paris
# 50 Mo : suffisant pour des documents et images courants, sans laisser saturer le stockage d'un seul envoi
MAX_UPLOAD_MB=50

# --- Back (API) ---
BACK_PORT=3000
BACK_PHRASE=Hello World depuis le back !
# Sous /data obligatoirement : c'est là qu'est monté le volume "stockage", ailleurs les fichiers seraient perdus
STORAGE_DIR=/data/files
# ~0,36 ms de CPU par requête mesuré : 0,25 CPU tient ~690 req/s, au niveau de la gateway (pas de CPU gaspillé)
BACK_CPUS=0.25
# Pic mesuré ~20 Mo : 128 Mo laissent plus de 6x de marge pour les futurs uploads
BACK_MEMORY=128M
# Tas Node à la moitié de la limite : le reste couvre la mémoire hors tas (buffers des flux d'upload)
BACK_NODE_MAX_MEMORY=64
# Réservation au-dessus du pic mesuré : le service garde de quoi tourner si l'hôte manque de mémoire
BACK_MEMORY_RESERVATION=32M

# --- Gateway (nginx) ---
GATEWAY_PORT=80
# 1 worker : un seul CPU alloué (moins d'un), plus de workers que de CPU n'apporterait rien
GATEWAY_WORKER_PROCESSES=1
GATEWAY_WORKER_CONNECTIONS=512
# ~0,42 ms de CPU par requête mesuré : 0,25 CPU tient ~600 req/s, équilibré avec le front et le back
GATEWAY_CPUS=0.25
# Pic mesuré ~4 Mo (contre ~20 Mo pour Node) : 32 Mo suffisent largement, nginx écrit les gros corps sur disque
GATEWAY_MEMORY=32M
GATEWAY_MEMORY_RESERVATION=8M

# --- Front (point d'entrée) ---
FRONT_PORT=80
# 8080 côté hôte : évite le port 80, souvent déjà pris ou réservé sur la machine
FRONT_PUBLISHED_PORT=8080
# Service le plus coûteux (~0,74 ms de CPU par requête, il relaie tout) : le double des autres
FRONT_CPUS=0.50
# Pic mesuré ~25 Mo : même logique que le back (128 Mo de limite, tas à 64 Mo)
FRONT_MEMORY=128M
FRONT_NODE_MAX_MEMORY=64
FRONT_MEMORY_RESERVATION=32M

# --- Bench (profil "bench", outil de mesure) ---
# 1 CPU : plus que les 3 services réunis, pour que l'outil de mesure ne soit jamais le goulot
BENCH_CPUS=1.0
# ab ne garde presque rien en mémoire (~2 Mo mesurés)
BENCH_MEMORY=32M
