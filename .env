# Un seul fichier pour toute la configuration : on règle la stack sans toucher au compose ni aux Dockerfile.
# Versionné volontairement : il ne contient aucun secret.

# --- Commun ---
# Version fixée plutôt que latest : build reproductible
ALPINE_VERSION=3.20
TZ=Europe/Paris
# 50 Mo : suffisant pour des documents et images courants, sans laisser saturer le stockage d'un seul envoi
MAX_UPLOAD_MB=50

# --- Back (API) ---
BACK_PORT=3000
# 128 Mo de tas sous 192 Mo de limite : marge pour la mémoire hors tas de Node
BACK_NODE_MAX_MEMORY=128
BACK_PHRASE=Hello World depuis le back !
# Sous /data obligatoirement : c'est là qu'est monté le volume "stockage", ailleurs les fichiers seraient perdus
STORAGE_DIR=/data/files
# ~10 Mo mesurés au repos : 192 Mo laissent une large marge, 64 Mo garantis suffisent à démarrer
BACK_CPUS=0.50
BACK_MEMORY=192M
BACK_MEMORY_RESERVATION=64M

# --- Gateway (nginx) ---
GATEWAY_PORT=80
# 1 worker pour 0,5 CPU : plus de workers que de CPU n'apporterait rien
GATEWAY_WORKER_PROCESSES=1
GATEWAY_WORKER_CONNECTIONS=512
# ~2 Mo mesurés au repos : nginx a besoin de beaucoup moins que les services Node
GATEWAY_CPUS=0.50
GATEWAY_MEMORY=64M
GATEWAY_MEMORY_RESERVATION=16M

# --- Front (point d'entrée) ---
FRONT_PORT=80
# 8080 côté hôte : évite le port 80, souvent déjà pris ou réservé sur la machine
FRONT_PUBLISHED_PORT=8080
FRONT_NODE_MAX_MEMORY=128
# Même logique que le back (~9 Mo mesurés au repos)
FRONT_CPUS=0.50
FRONT_MEMORY=192M
FRONT_MEMORY_RESERVATION=64M
