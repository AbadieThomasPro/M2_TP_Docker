# Dépendances npm : installées dans les images (npm ci), jamais versionnées (lourdes et propres à l'OS)
node_modules/
# Artefacts de build Angular : régénérés par le stage de build de l'image front
dist/
.angular/
# Logs locaux
*.log
# Rapports de la CI (lint, JUnit, audit, policy) : régénérés à chaque exécution du pipeline
ci/reports/
# Configuration locale : créée par cp .env.example .env, jamais versionnée (seul le modèle l'est)
.env
# Jeton Claude personnel de l'étape IA : un secret, jamais versionné (modèle : ci/ia.env.example)
ci/ia.env
