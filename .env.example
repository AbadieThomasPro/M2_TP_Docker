# Modèle de la configuration, versionné. À copier avant le premier lancement :
#   cp .env.example .env
# Le .env n'est jamais versionné (.gitignore) : chaque déploiement règle ses propres valeurs sans les
# commiter, et un secret ajouté un jour n'y fuirait pas. Le jeton Claude de l'étape IA a son propre
# fichier : voir ci/ia.env.example. Les deux fichiers gardent les mêmes variables : le lint le vérifie.
# Les valeurs ci-dessous sont celles du projet, justifiées par les mesures.

# Un seul fichier pour toute la configuration : on règle la stack sans toucher au compose ni aux Dockerfile.
# Ressources fixées d'après les mesures de Bench/run-bench.ps1 sur l'application réelle (détail dans le
# README, section Benchmark) : CPU dosé selon le coût par requête de chaque service, 1 CPU au total.

# --- Commun ---
# Version fixée plutôt que latest : build reproductible.
# 3.22 et non 3.20 : Angular 22 exige Node >= 22.22 (3.20 ne fournit que Node 20.15), et Alpine 3.20
# comme Node 20 sont en fin de support (avril 2026). 3.22 : Node 22 LTS, OS maintenu jusqu'en 2027
ALPINE_VERSION=3.22
TZ=Europe/Paris
# 50 Mo : suffisant pour des documents et images courants, sans laisser saturer le stockage d'un seul envoi
# Partagé par la gateway (refus avant le back) et le back (double sécurité)
MAX_UPLOAD_MB=50

# --- Back (API) ---
BACK_PORT=3000
# Sous /data obligatoirement : c'est là qu'est monté le volume "stockage", ailleurs les fichiers seraient perdus
STORAGE_DIR=/data/files
# GID du groupe partagé back / cleaner : une seule valeur ici, donc identique dans les deux images
STORAGE_GID=1500

# --- Fichiers éphémères ---
# 24 h par défaut : le cas d'usage type (partager un fichier pour la journée)
TTL_DEFAULT_H=24
# 7 jours max : au-delà, ce n'est plus du stockage temporaire et le volume se remplirait
TTL_MAX_H=168
# 1 Go au total : protège le disque de l'hôte, même si des envois s'accumulent avant leur expiration
STORAGE_QUOTA_MB=1024
# Service le plus coûteux de l'application réelle : ~2,8 ms de CPU par requête de liste (lecture du dossier
# + un stat par fichier), 7x la gateway. 0,65 CPU (sur 1 CPU au total) tient ~230 req/s, au niveau des autres
BACK_CPUS=0.65
# Pic mesuré ~33 Mo (5 envois de 20 Mo en parallèle, écriture en flux) : 128 Mo laissent ~4x de marge
BACK_MEMORY=128M
# Tas Node à la moitié de la limite : le reste couvre la mémoire hors tas (buffers des flux d'upload)
BACK_NODE_MAX_MEMORY=64
# Réservation au-dessus du pic mesuré : le service garde de quoi tourner si l'hôte manque de mémoire
BACK_MEMORY_RESERVATION=32M

# --- Cleaner (worker de nettoyage) ---
# 60 s : la libération d'espace disque n'a pas besoin d'être plus rapide, l'API masque déjà les expirés
CLEANUP_INTERVAL_S=60
# 60 min : même un envoi de 50 Mo à 100 Ko/s dure moins de 9 min, un .part plus vieux est abandonné
INCOMING_MAX_AGE_MIN=60
# Mesuré sur 10 000 fichiers expirés : passe en 6 s à 0,10 CPU (13 s à 0,05, 2 s à 0,25).
# 0,10 : la passe reste bien plus courte que l'intervalle, et le worker n'a besoin de rien au repos (0 %)
CLEANER_CPUS=0.10
# Pic mesuré ~4 Mo à 0,10 CPU (~8 Mo à 0,05, le listage de 10 000 noms) ; ~0,5 Mo au repos
CLEANER_MEMORY=16M
# Minimum accepté par Docker pour une réservation
CLEANER_MEMORY_RESERVATION=6M

# --- Gateway (nginx) ---
GATEWAY_PORT=80
# 1 worker : un seul CPU alloué (moins d'un), plus de workers que de CPU n'apporterait rien
GATEWAY_WORKER_PROCESSES=1
GATEWAY_WORKER_CONNECTIONS=512
# Le moins coûteux : ~0,4 ms de CPU par requête mesuré (7x moins que le back). 0,10 CPU tient ~250 req/s
GATEWAY_CPUS=0.10
# ~4 Mo en charge normale, mais pic à ~26 Mo pendant 5 envois de 20 Mo en parallèle ; le tmpfs (8 Mo)
# compte aussi dans cette limite : 26 + 8 dépasserait 32 Mo, d'où 48 Mo (encore 2,7x moins que Node)
GATEWAY_MEMORY=48M
GATEWAY_MEMORY_RESERVATION=8M
# /tmp en RAM (lecture seule ailleurs) : quelques Ko suffisent (config, PID), nginx ne bufferise
# ni les envois ni les téléchargements sur disque. Compté dans la limite mémoire du conteneur
GATEWAY_TMPFS_SIZE=8m

# --- Front (point d'entrée) ---
FRONT_PORT=80
# 8080 côté hôte : évite le port 80, souvent déjà pris ou réservé sur la machine
FRONT_PUBLISHED_PORT=8080
# ~1,2 ms de CPU par requête mesuré (il relaie tout, 3x la gateway) : 0,25 CPU tient ~210 req/s
FRONT_CPUS=0.25
# Pic mesuré ~37 Mo (5 envois en parallèle relayés en flux) : même logique que le back (128 Mo, tas à 64 Mo)
FRONT_MEMORY=128M
FRONT_NODE_MAX_MEMORY=64
FRONT_MEMORY_RESERVATION=32M

# --- Tampons TCP du front et de la gateway (sysctls net.ipv4.tcp_rmem / tcp_wmem, maximum en octets) ---
# Un relais d'envoi tient 2 connexions par fichier, et le noyau leur donne jusqu'à 6 Mo (réception) et
# 4 Mo (émission) de tampons, comptés dans la mémoire du conteneur. Mesuré : 55 Mo de tampons dans le front
# pour 10 envois de 40 Mo, et front tué (OOM) à 20. Plafonnés à 1 Mo : 19 Mo pour 10 envois, 20 envois
# acceptés (front à 66 % de sa limite), débit inchangé (~30 Mo/s : sur un réseau interne, 1 Mo suffit)
TCP_BUFFER_MAX_BYTES=1048576

# --- Swarm (docker-stack.yml uniquement) ---
# Réservations CPU : le planificateur de Swarm ne place une instance que s'il reste ce CPU sur la machine.
# Environ la moitié de la limite : de quoi tenir une charge normale, et la stack de base ne réserve
# que ~1,1 CPU (3 back + front + gateway + cleaner), loin des 12 CPU de la machine de test
BACK_CPUS_RESERVATION=0.30
FRONT_CPUS_RESERVATION=0.10
GATEWAY_CPUS_RESERVATION=0.05
CLEANER_CPUS_RESERVATION=0.05
# CPU du front et de la gateway en mode Swarm : avec 3 back (1,95 CPU au total), garder 0,25 / 0,10 laisse
# le front et la gateway en goulot (mesuré : 153 req/s avec 1, 3 ou 5 back). Dosés dans le rapport de coûts
# mesuré back / front / gateway = 7 / 3 / 1 : 0,75 et 0,30 (mesuré avec 5 back : 417 req/s, x2,7)
SWARM_FRONT_CPUS=0.75
SWARM_GATEWAY_CPUS=0.30
# 6 instances du back au plus par machine : 6 x 0,65 = 3,9 CPU et 768 Mo au pire, environ un tiers
# de la machine ; au-delà, les instances demandées restent en attente au lieu de la saturer
BACK_MAX_REPLICAS_PER_NODE=6

# --- Autoscaling (docker-stack.yml uniquement, image Autoscaler/) ---
# Seuils issus du benchmark du 26/10 (README, partie Scalabilité ; compte rendu dans features/)
# Une boucle toutes les 10 s (~14 s en réalité : docker stats met ~4 s à 0,10 CPU). Plus souvent,
# l'autoscaler chargerait lui-même la machine qu'il surveille
AUTOSCALE_INTERVAL_S=10
# +1 instance au-dessus de 70 % de la limite CPU, et pas 80 % : une instance met 10 à 15 s à être prête,
# la charge continue de monter pendant ce temps ; on garde ainsi les services sous 80 %
AUTOSCALE_CPU_UP=70
# -1 instance sous 25 % : écart large avec 70 % (hystérésis), sinon retirer une instance ferait
# remonter la charge au-dessus du seuil haut et le service oscillerait
AUTOSCALE_CPU_DOWN=25
# Mémoire de la PIRE instance : 80 % = marge avant l'OOM (gateway mesurée à 98 % à 10 envois de 40 Mo)
AUTOSCALE_MEM_UP=80
AUTOSCALE_MEM_DOWN=50
# 3 relevés hauts de suite (~40 s) avant de monter : un pic isolé ne crée pas d'instance.
# 6 relevés bas (~80 s) avant de descendre : retirer trop vite coûte plus cher que garder une instance
AUTOSCALE_UP_SAMPLES=3
AUTOSCALE_DOWN_SAMPLES=6
# Pause après une action : la nouvelle instance doit prendre sa part de la charge avant de remesurer
AUTOSCALE_COOLDOWN_UP_S=30
AUTOSCALE_COOLDOWN_DOWN_S=60
# Jamais plus de 80 % du CPU et de la mémoire de la machine pour la somme des limites de la stack
AUTOSCALE_HOST_BUDGET_PCT=80
# Bornes par service. Back : 2 minimum pour qu'un crash ne coupe pas l'API, 6 maximum (= BACK_MAX_REPLICAS_PER_NODE,
# ~110 req/s par instance sous 80 %). Gateway : 3 (~400 req/s chacune, plus que ce que 6 back servent).
# Front : 2 (~550 req/s chacun). Au-delà, plus d'instances n'apportent rien (mesuré)
BACK_AUTOSCALE_MIN=2
BACK_AUTOSCALE_MAX=6
GATEWAY_AUTOSCALE_MIN=1
GATEWAY_AUTOSCALE_MAX=3
FRONT_AUTOSCALE_MIN=1
FRONT_AUTOSCALE_MAX=2
# Groupe propriétaire du socket Docker vu d'un conteneur : 0 sur Docker Desktop (mesuré avec stat).
# Sur un Linux classique, mettre le GID du groupe "docker" de l'hôte (getent group docker)
DOCKER_GID=0
# Une boucle shell et un docker stats toutes les 10 s : 0,6 Mo au repos (mesuré). 64 Mo couvrent le client
# docker pendant un relevé ; 0,10 CPU lui suffit, le relevé dure juste un peu plus longtemps
AUTOSCALER_CPUS=0.10
AUTOSCALER_MEMORY=64M
AUTOSCALER_CPUS_RESERVATION=0.05
AUTOSCALER_MEMORY_RESERVATION=8M
# Gateway en Swarm : 96 Mo au lieu de 48. Mesuré à 98 % de 48 Mo pour 10 envois de 40 Mo en parallèle et
# 502 à 20 ; une instance de plus ne soulage pas un envoi déjà en cours. Reste en dessous de Node (128 Mo)
SWARM_GATEWAY_MEMORY=96M

# --- Bench (outil de charge, profil "bench" : ne démarre pas avec docker compose up ; voir docs/tester-la-charge.md) ---
# 1 CPU : plus que les 3 services réunis, pour que l'outil de mesure ne soit jamais le goulot
BENCH_CPUS=1.0
# ab ne garde presque rien en mémoire (~2 Mo mesurés)
BENCH_MEMORY=32M

# --- CI (ci/compose.yml : étapes lint, test, security, policy) ---
# Mêmes limites pour chaque étape : ce sont des tâches courtes, mais deux tournent en parallèle et
# ne doivent pas étouffer la machine (ni la stack déjà déployée).
# Pics mesurés (memory.peak du conteneur) : lint 19 Mo, test 68 Mo (lanceur + serveur testé),
# security 38 Mo, policy 9 Mo. 256 Mo = x3,7 sur la plus lourde : marge pour des tests qui grossissent
CI_CPUS=1.0
CI_MEMORY=256M
# /tmp en RAM de chaque étape : fichiers des tests (envois de ~1 Mo) et cache npm de l'audit
CI_TMPFS_SIZE=64m
# Gravité à partir de laquelle npm audit fait échouer le pipeline : high = failles graves seulement,
# les failles modérées sont signalées dans le rapport sans bloquer la livraison
CI_AUDIT_LEVEL=high

# --- CI : étape IA (optionnelle, ./ci/pipeline.sh --ia ; jeton dans ci/ia.env, jamais ici) ---
# Opus 5.5 : le plus capable pour déduire des tests d'une spécification (choix du projet) ; modifiable
# pour comparer coût et qualité (ex. claude-sonnet-5-5)
CI_IA_MODEL=claude-opus-5-5
# 40 tours : écrire les tests, les lancer, corriger les tests faux ; au-delà, l'agent tourne en rond
CI_IA_MAX_TURNS=40
# Estimation locale du SDK (l'abonnement n'est pas facturé à l'appel) : un appel minimal est déjà
# estimé à 0,12 $ (~15 000 jetons d'instructions de Claude Code en cache) ; 3 $ laissent la marge d'un
# vrai travail tout en coupant un agent qui s'emballe
CI_IA_BUDGET_USD=3
# Claude Code (binaire natif) + serveurs Node lancés par les tests : bien plus que les autres étapes.
# Pic mesuré : 210 Mo (32 tests écrits puis lancés, un serveur par test) ; 512 Mo = x2,4 de marge
CI_IA_MEMORY=512M
