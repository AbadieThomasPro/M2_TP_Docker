# Modèle plutôt que config figée : les ${VARIABLES} sont remplacées au run par entrypoint.sh

# Un worker par CPU alloué : plus de workers que de CPU n'apporterait rien
worker_processes ${WORKER_PROCESSES};

# /tmp car nginx tourne sans root et ne peut pas écrire ailleurs
pid /tmp/nginx.pid;
# Logs sur la sortie standard : visibles avec docker logs, pas de fichier qui grossit dans le conteneur
error_log /dev/stderr warn;

events {
    worker_connections ${WORKER_CONNECTIONS};
}

http {
    access_log /dev/stdout;

    # Fichiers temporaires dans /tmp pour la même raison (utilisateur non-root)
    client_body_temp_path /tmp/client_body;
    proxy_temp_path       /tmp/proxy;
    fastcgi_temp_path     /tmp/fastcgi;
    uwsgi_temp_path       /tmp/uwsgi;
    scgi_temp_path        /tmp/scgi;

    # Taille max d'upload réglée au run : un fichier trop gros est refusé (413) sans charger le back
    client_max_body_size ${MAX_UPLOAD_MB}m;

    # DNS interne de Docker, interrogé à chaque expiration (10 s) plutôt qu'une seule fois au démarrage :
    # les instances du back ajoutées ou retirées par --scale sont vues sans redémarrer nginx.
    # ipv6=off : les réseaux du compose sont en IPv4, inutile d'attendre des réponses AAAA.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    server {
        listen ${PORT};

        # Réponse directe sans passer par le back : le healthcheck ne teste que la gateway
        location = /health {
            access_log off;
            return 200 "OK";
        }

        # Seul chemin autorisé vers le back ; en-têtes transmis pour que le back connaisse le vrai client
        location /api/ {
            # Adresse dans une variable : c'est ce qui oblige nginx à passer par le resolver à chaque
            # requête (une adresse écrite en dur n'est résolue qu'une fois, au démarrage)
            set $back_upstream http://${BACK_HOST}:${BACK_PORT};
            proxy_pass $back_upstream;

            # Envoi transmis au back au fil de l'eau au lieu d'être d'abord écrit en entier dans /tmp :
            # pas de copie disque en double, et /tmp peut rester un petit tmpfs en RAM
            proxy_request_buffering off;
            # HTTP/1.1 vers le back : nécessaire pour transmettre en flux un corps envoyé par morceaux (chunked)
            proxy_http_version 1.1;
            proxy_set_header Connection "";

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # Tout le reste est refusé : la gateway ne doit rien exposer d'autre que l'API
        location / {
            return 404;
        }
    }
}
